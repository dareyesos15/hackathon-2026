# Copiar a .env para cambiar los valores de demo. Nunca subir .env al repositorio.
# Sin .env, docker compose usa exactamente estos valores por defecto.

POSTGRES_PASSWORD=dacora

# Sal secreta para HMAC-SHA256 de datos personales (Habeas Data, principio I).
PII_SALT=demo-salt-cambiar-en-produccion

# Similitud de texto para la deduplicación: tfidf (por defecto) | minilm (research R1)
SIMILARITY_PROVIDER=tfidf

# Tokens fijos por rol (research R9). La ciudadanía no usa token: reporta y consulta como anónima.
TOKEN_OPERADOR_PMU=pmu-demo
TOKEN_PUBLICO=publico-demo
TOKEN_COE=coe-demo
TOKEN_INSPECTOR=inspector-demo
TOKEN_AGENCIA=agencia-demo
# Administrador de la demo: simulaciones con datos (escenario) o sin datos (tablero vacío).
TOKEN_ADMIN=admin-demo
# Contraseña de los usuarios de prueba (coe, pmu, bomberos, cruzroja, defensacivil,
# infraestructura, admin). Solo para la demo.
DEMO_PASSWORD=dacora2026

# Despacho (specs/002): avance SIMULADO de recursos tipo RFID y umbral de críticos sin despacho.
SIMULATE_TRACKS=true
# Sensor de zonas inseguras (patente NC2025/0015763): lecturas SIMULADAS cada ZONE_TICK_S s.
SIMULATE_ZONE_SENSORS=true
ZONE_TICK_S=6
TRACK_SPEEDUP=20
UNATTENDED_ALERT_MIN=15

# Lluvia de la predicción de cascada al arrancar: "simulado" o "cdiac" (precipitación real del
# CDIAC/SIMAC, UNAL Manizales; requiere internet en el servidor). El administrador la cambia en
# caliente desde /admin/. Si CDIAC no responde o sus datos tienen más de CDIAC_MAX_AGE_MIN, se usa
# la lluvia SIMULADA de respaldo.
RAIN_SOURCE=simulado
CDIAC_POLL_S=300
CDIAC_MAX_AGE_MIN=60

# Interfaz: marcar como "SIMULADO" los datos sintéticos (true, demo) u ocultar esas marcas
# (false, despliegue con datos reales). Se aplica al construir: docker compose up -d --build web
NEXT_PUBLIC_DEMO_MODE=true

# Casos de ejemplo de recuperación (scripts/seed_recovery_example.py): se cargan al arrancar la API
# y después de cada reinicio de la demo. Solo en modo demo; en producción, false.
SEED_RECOVERY_EXAMPLES=true
